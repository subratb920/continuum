# continuum-bridge-spine (UI) in the cloud (Google Cloud). Committed: no secrets in a UI.
# Continuum Deploy reads this file from the branch it deploys.
# SERVE=built: the image builds the UI with these settings at start-up and serves it on $PORT.
SERVE=built
# continuum-api's address, filled in at deploy time (follows its own address: https://api.continuum-console.one)
VITE_API_BASE_URL=${continuum-api.url}
# Continuum Deploy's sign-in address: shows the Deploy menu
VITE_DEPLOY_LOGIN_URL=https://api.deploy.continuum-console.one/auth/login?from=continuum
# Not deployed in the cloud: the continuum-create link stays hidden
# VITE_CREATE_URL=
# How users reach the team (profile menu → Support / Contact us). No VITE_SUPPORT_PHONE
# means "coming soon"; add it only with a number (Continuum Deploy treats an empty value
# here as a secret to fill in)
VITE_SUPPORT_EMAIL=support@continuum-console.one

# The Agents screen on the real brain, through continuum-api's /brain: turned on
# with continuum-api's BRAIN_URL (until then the screen shows a simulation)
# VITE_BRAIN_MODE=live
# VITE_BRAIN_API_URL=${continuum-api.url}
