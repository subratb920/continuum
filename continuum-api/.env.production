# continuum-api in the cloud (Google Cloud). Committed: no secret values here.
# Continuum Deploy reads this file from the branch it deploys. A name with an
# empty value is a secret: its value is entered on the deploy page (stored
# encrypted, never in GitHub). MONGO_URI comes from the database; PORT from
# Continuum Deploy.

NODE_ENV=production
LOG_LEVEL=info
DB_NAME=continuum

CLIENT_ORIGIN=http://continuum-bridge-spine-continuum.136.68.176.81.sslip.io
CLIENT_AUTH_CALLBACK_URL=http://continuum-bridge-spine-continuum.136.68.176.81.sslip.io/auth/callback
GITHUB_CALLBACK_URL=http://continuum-api-continuum.136.68.176.81.sslip.io/auth/github/callback
# The cloud GitHub OAuth app's Client ID (not a secret): fill in, commit, push
GITHUB_CLIENT_ID=Ov23li5gNCaZiY108CAt

# Secrets: values on the deploy page
JWT_SECRET=
GITHUB_CLIENT_SECRET=
