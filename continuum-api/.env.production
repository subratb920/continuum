# continuum-api in the cloud (Google Cloud). Committed: no secret values here.
# Continuum Deploy reads this file from the branch it deploys. A name with an
# empty value is a secret: its value is entered on the deploy page (stored
# encrypted, never in GitHub). MONGO_URI comes from the database; PORT from
# Continuum Deploy.

NODE_ENV=production
LOG_LEVEL=info
DB_NAME=continuum

CLIENT_ORIGIN=https://app.continuum-console.one
CLIENT_AUTH_CALLBACK_URL=https://app.continuum-console.one/auth/callback
GITHUB_CALLBACK_URL=https://api.continuum-console.one/auth/github/callback
# The cloud GitHub OAuth app's Client ID (not a secret): fill in, commit, push
GITHUB_CLIENT_ID=Ov23li5gNCaZiY108CAt

# Secrets: values on the deploy page
JWT_SECRET=
GITHUB_CLIENT_SECRET=

# Sign-in for Continuum Deploy (SSO). Continuum Deploy checks the issuer "continuum-api".
OAUTH_ISSUER=continuum-api
OAUTH_CLIENT_ID=continuum-deploy
OAUTH_REDIRECT_URIS=https://api.deploy.continuum-console.one/auth/callback
# Secrets: values on the deploy page
# - OAUTH_SIGNING_KEY: an Ed25519 private key (PEM), base64 on one line
# - OAUTH_CLIENT_SECRET_HASH: sha256 (hex) of continuum-deploy-api's OAUTH_CLIENT_SECRET
OAUTH_SIGNING_KEY=
OAUTH_CLIENT_SECRET_HASH=

# Continuum Workspaces (not secrets): the service's address inside the cluster
# (the Continuum Deploy add-on runs it in namespace continuum-workspaces) and
# where browsers open the editors. Turned on in step W3d, after the add-on is
# running: until then the Workspaces page says it isn't set up here.
# WORKSPACES_URL=http://continuum-workspaces.continuum-workspaces.svc.cluster.local:45177
# WORKSPACES_PUBLIC_URL=https://workspaces.continuum-console.one
