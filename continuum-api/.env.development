# continuum-api, running locally. Committed: no secret values here.
# Secrets (MONGO_URI, JWT_SECRET, GITHUB_CLIENT_SECRET) come from .env.local or .env.

NODE_ENV=development
LOG_LEVEL=debug
PORT=45170
DB_NAME=continuum

CLIENT_ORIGIN=http://localhost:45173
CLIENT_AUTH_CALLBACK_URL=http://localhost:45173/auth/callback
GITHUB_CALLBACK_URL=http://localhost:45170/auth/github/callback
