{
  "apps": [
    {
      "name": "data-runner",
      "path": "continuum-data/runner-image",
      "buildOnly": true
    },
    {
      "name": "continuum-api",
      "path": "continuum-api",
      "dockerfile": "continuum-api/Dockerfile.cloud",
      "dependsOn": [
        "data-runner"
      ],
      "clusterAccess": [
        "pods"
      ],
      "port": 8080,
      "scale": {
        "min": 1,
        "max": 2,
        "cpu": 0.25,
        "memory": "512Mi",
        "targetCpu": 70,
        "autoMemoryMax": "2Gi"
      }
    },
    {
      "name": "continuum-bridge-spine",
      "path": "continuum-bridge-spine",
      "dependsOn": [
        "continuum-api"
      ],
      "scale": {
        "min": 1,
        "max": 2,
        "cpu": 0.25,
        "memory": "1Gi",
        "targetCpu": 70,
        "autoMemoryMax": "2Gi"
      },
      "port": 8080
    }
  ]
}
